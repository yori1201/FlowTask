rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 200)) &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             (!('lastBackupAtMillis' in data) || data.lastBackupAtMillis == null || (data.lastBackupAtMillis is int && data.lastBackupAtMillis >= 0)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidProject(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 500)) &&
             data.colorHex is string && data.colorHex.size() >= 4 && data.colorHex.size() <= 9 &&
             data.iconName is string && data.iconName.size() >= 1 && data.iconName.size() <= 40 &&
             data.archived is bool &&
             data.deleted is bool &&
             data.revision is int && data.revision >= 1 && data.revision <= 1000000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTask(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             data.description is string && data.description.size() <= 4000 &&
             data.status is string && data.status in ['TODO', 'IN_PROGRESS', 'COMPLETED'] &&
             data.priority is string && data.priority in ['LOW', 'MEDIUM', 'HIGH', 'URGENT'] &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             (!('projectId' in data) || data.projectId == null || (data.projectId is string && data.projectId.size() <= 128)) &&
             (!('startAtMillis' in data) || data.startAtMillis == null || (data.startAtMillis is int && data.startAtMillis >= 0)) &&
             (!('dueAtMillis' in data) || data.dueAtMillis == null || (data.dueAtMillis is int && data.dueAtMillis >= 0)) &&
             (!('reminderAtMillis' in data) || data.reminderAtMillis == null || (data.reminderAtMillis is int && data.reminderAtMillis >= 0)) &&
             (!('completedAtMillis' in data) || data.completedAtMillis == null || (data.completedAtMillis is int && data.completedAtMillis >= 0)) &&
             data.recurrence is string && data.recurrence in ['NONE', 'DAILY', 'WEEKLY', 'MONTHLY', 'YEARLY'] &&
             data.tags is list && data.tags.size() <= 10 && (data.tags.size() == 0 || data.tags[0] is string) &&
             data.subtasks is list && data.subtasks.size() <= 20 && (data.subtasks.size() == 0 || data.subtasks[0] is map) &&
             data.archived is bool &&
             data.deleted is bool &&
             data.revision is int && data.revision >= 1 && data.revision <= 1000000 &&
             data.deviceId is string && data.deviceId.size() >= 1 && data.deviceId.size() <= 80 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidNote(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 160 &&
             data.content is string && data.content.size() <= 50000 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             (!('projectId' in data) || data.projectId == null || (data.projectId is string && data.projectId.size() <= 128)) &&
             data.tags is list && data.tags.size() <= 10 && (data.tags.size() == 0 || data.tags[0] is string) &&
             data.linkedTaskIds is list && data.linkedTaskIds.size() <= 20 && (data.linkedTaskIds.size() == 0 || data.linkedTaskIds[0] is string) &&
             data.pinned is bool &&
             data.favorite is bool &&
             data.archived is bool &&
             data.deleted is bool &&
             data.wordCount is int && data.wordCount >= 0 && data.wordCount <= 50000 &&
             data.revision is int && data.revision >= 1 && data.revision <= 1000000 &&
             data.deviceId is string && data.deviceId.size() >= 1 && data.deviceId.size() <= 80 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidReminderEvent(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             (!('taskId' in data) || data.taskId == null || (data.taskId is string && data.taskId.size() <= 128)) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             data.message is string && data.message.size() <= 500 &&
             data.reminderType is string && data.reminderType in ['TASK_REMINDER', 'DEADLINE', 'OVERDUE', 'DAILY_SUMMARY', 'SYNC_ALERT'] &&
             data.scheduledAtMillis is int && data.scheduledAtMillis >= 0 &&
             (!('snoozedUntilMillis' in data) || data.snoozedUntilMillis == null || (data.snoozedUntilMillis is int && data.snoozedUntilMillis >= 0)) &&
             data.dismissed is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidBackupSnapshot(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.formatVersion is int && data.formatVersion >= 1 && data.formatVersion <= 100 &&
             data.label is string && data.label.size() >= 1 && data.label.size() <= 120 &&
             data.taskCount is int && data.taskCount >= 0 && data.taskCount <= 5000 &&
             data.noteCount is int && data.noteCount >= 0 && data.noteCount <= 5000 &&
             data.projectCount is int && data.projectCount >= 0 && data.projectCount <= 500 &&
             data.checksum is string && data.checksum.size() >= 8 && data.checksum.size() <= 128 &&
             data.snapshotData is map &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // --- USER PROFILE & PRIVATE WORKSPACE ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'lastBackupAtMillis', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['lastBackupAtMillis', 'updatedAt'])
                       );

      allow delete: if isOwner(userId) && isValidId(userId);

      // --- PROJECTS ---
      match /projects/{projectId} {
        allow get: if isOwner(userId) && isValidId(projectId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(projectId) &&
                         incoming().keys().hasAll(['userId', 'name', 'colorHex', 'iconName', 'archived', 'deleted', 'revision', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'description', 'colorHex', 'iconName', 'archived', 'deleted', 'revision', 'createdAt', 'updatedAt']) &&
                         isValidProject(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(projectId) &&
                         isValidProject(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['archived', 'deleted', 'revision', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'colorHex', 'iconName', 'archived', 'deleted', 'revision', 'updatedAt'])
                         );

        allow delete: if isOwner(userId) && isValidId(projectId);
      }

      // --- TASKS ---
      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(taskId) &&
                         incoming().keys().hasAll(['userId', 'title', 'description', 'status', 'priority', 'category', 'recurrence', 'tags', 'subtasks', 'archived', 'deleted', 'revision', 'deviceId', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'description', 'status', 'priority', 'category', 'projectId', 'startAtMillis', 'dueAtMillis', 'reminderAtMillis', 'completedAtMillis', 'recurrence', 'tags', 'subtasks', 'archived', 'deleted', 'revision', 'deviceId', 'createdAt', 'updatedAt']) &&
                         isValidTask(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(taskId) &&
                         isValidTask(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedAtMillis', 'subtasks', 'archived', 'deleted', 'revision', 'deviceId', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'status', 'priority', 'category', 'projectId', 'startAtMillis', 'dueAtMillis', 'reminderAtMillis', 'completedAtMillis', 'recurrence', 'tags', 'subtasks', 'archived', 'deleted', 'revision', 'deviceId', 'updatedAt'])
                         );

        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      // --- NOTES ---
      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(noteId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(noteId) &&
                         incoming().keys().hasAll(['userId', 'title', 'content', 'category', 'tags', 'linkedTaskIds', 'pinned', 'favorite', 'archived', 'deleted', 'wordCount', 'revision', 'deviceId', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'content', 'category', 'projectId', 'tags', 'linkedTaskIds', 'pinned', 'favorite', 'archived', 'deleted', 'wordCount', 'revision', 'deviceId', 'createdAt', 'updatedAt']) &&
                         isValidNote(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(noteId) &&
                         isValidNote(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['pinned', 'favorite', 'archived', 'deleted', 'revision', 'deviceId', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'category', 'projectId', 'tags', 'linkedTaskIds', 'pinned', 'favorite', 'archived', 'deleted', 'wordCount', 'revision', 'deviceId', 'updatedAt'])
                         );

        allow delete: if isOwner(userId) && isValidId(noteId);
      }

      // --- REMINDERS & NOTIFICATION HISTORY ---
      match /reminders/{reminderId} {
        allow get: if isOwner(userId) && isValidId(reminderId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(reminderId) &&
                         incoming().keys().hasAll(['userId', 'title', 'message', 'reminderType', 'scheduledAtMillis', 'dismissed', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'taskId', 'title', 'message', 'reminderType', 'scheduledAtMillis', 'snoozedUntilMillis', 'dismissed', 'createdAt', 'updatedAt']) &&
                         isValidReminderEvent(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(reminderId) &&
                         isValidReminderEvent(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['snoozedUntilMillis', 'dismissed', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'message', 'scheduledAtMillis', 'snoozedUntilMillis', 'dismissed', 'updatedAt'])
                         );

        allow delete: if isOwner(userId) && isValidId(reminderId);
      }

      // --- CLOUD BACKUPS ---
      match /backups/{backupId} {
        allow get: if isOwner(userId) && isValidId(backupId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(backupId) &&
                         incoming().keys().hasAll(['userId', 'formatVersion', 'label', 'taskCount', 'noteCount', 'projectCount', 'checksum', 'snapshotData', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'formatVersion', 'label', 'taskCount', 'noteCount', 'projectCount', 'checksum', 'snapshotData', 'createdAt', 'updatedAt']) &&
                         isValidBackupSnapshot(incoming());

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(backupId);
      }
    }
  }
}
